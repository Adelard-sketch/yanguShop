{
  "name": "yangu-shop",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "serverless-http": "^2.8.0"
  },
  "scripts": {
    "start": "node backend/server.js",
    "start:frontend": "cd frontend && npm start",
